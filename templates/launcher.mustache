{{!
    @template local_learninglens/launcher

    Circular launcher button for Learning Lens.

    @copyright 2026 Paul Vincent <paulvincent@oca-uk.com>
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Example context (json):
    {
        "strings": {
            "launcher": "Learning Lens"
        }
    }
}}
<button type="button"
        class="local-learninglens-launcher"
        aria-expanded="false"
        aria-controls="local-learninglens-panel"
        aria-haspopup="dialog"
        title="{{strings.launcher}}">
    <span class="visually-hidden sr-only">{{strings.launcher}}</span>
    <i class="fa-solid fa-universal-access local-learninglens-launcher-icon" aria-hidden="true"></i>
</button>
